{
  "suite": "a-valid",
  "description": "合法信封 / 合法存储消息必须通过 schema 校验（对应 conformance/README.md 第 1 类）。",
  "cases": [
    {
      "name": "a/valid-full-envelope",
      "note": "携带全部可选字段的完整信封",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.4",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": 1793757060000,
        "replyTo": "msg_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "rootMessageId": "msg_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "hop": 1,
        "noReply": false,
        "kind": "request",
        "ccParent": true
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "a/valid-minimal-envelope",
      "note": "只带必填字段的最小信封（expiresAt/replyTo/rootMessageId 缺省）",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.4",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "hop": 0,
        "noReply": false,
        "kind": "info"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "a/valid-stored-message",
      "note": "存储侧消息：信封字段 + state/attempts 等列，且带未知列 claimed_by",
      "check": "schema",
      "schema": "message.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info",
        "protocol_version": "0.4",
        "state": "acked",
        "attempts": 2,
        "deliveredAt": 1793757000100,
        "ackedAt": 1793757000200,
        "lastError": null,
        "claimed_by": "instance-a"
      },
      "expect": {
        "ok": true
      }
    }
  ]
}
