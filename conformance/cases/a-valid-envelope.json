{
  "suite": "a-valid",
  "description": "合法信封 / 合法存储消息必须通过 schema 校验（对应 conformance/README.md 第 1 类）。",
  "cases": [
    {
      "name": "a/valid-full-envelope",
      "note": "携带全部可选字段的完整信封",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.4",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": 1793757060000,
        "replyTo": "msg_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "rootMessageId": "msg_aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
        "hop": 1,
        "noReply": false,
        "kind": "request",
        "ccManager": true
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "a/valid-minimal-envelope",
      "note": "只带必填字段的最小信封（expiresAt/replyTo/rootMessageId 缺省）",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.4",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "hop": 0,
        "noReply": false,
        "kind": "info"
      },
      "expect": {
        "ok": true
      }
    },
    {
      "name": "a/valid-stored-message",
      "note": "存储侧消息：信封字段 + state/attempts 等列，且带未知列 claimed_by",
      "check": "schema",
      "schema": "message.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "idempotency_key": "caller:retry-1",
        "from_agent": "agent-demo",
        "from_line": "frontend",
        "from_session": "session-11111111-1111-1111-1111-111111111111",
        "to_agent": "agent-demo",
        "to_line": "backend",
        "body": "build 产物已就绪，请拉到 backend 线验收。",
        "created_at": 1793757000000,
        "expires_at": null,
        "reply_to": null,
        "root_message_id": null,
        "hop": 0,
        "no_reply": 0,
        "kind": "request",
        "cc_manager": 0,
        "approval_state": null,
        "task_ref": null,
        "parent_task_ref": null,
        "task_scope": null,
        "subteam_policy": null,
        "max_members": null,
        "approved_by": null,
        "approved_at": null,
        "protocol_version": "0.4",
        "state": "queued",
        "claimed_by": null,
        "claimed_at": null,
        "delivered_at": null,
        "acked_at": null,
        "attempts": 0,
        "next_attempt_at": 0,
        "last_error": null
      },
      "expect": {
        "ok": true
      }
    }
  ]
}
