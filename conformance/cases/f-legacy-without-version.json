{
  "suite": "f-legacy-without-version",
  "description": "没有 protocolVersion 的旧消息 -> 视为 0.3 并接受（对应 conformance/README.md 第 6 类）。",
  "cases": [
    {
      "name": "f/envelope-without-protocolVersion",
      "note": "0.9.0 之前的信封没有该字段",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info"
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.3"
      }
    },
    {
      "name": "f/envelope-without-version-compatible",
      "note": "版本协商把缺省解析为 0.3，与 0.4 同 major",
      "check": "protocolVersion",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info"
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.3"
      }
    },
    {
      "name": "f/stored-message-without-protocol_version",
      "note": "迁移前的存储行没有 protocol_version 列值（DB 默认 '0.3'）",
      "check": "schema",
      "schema": "message.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "idempotency_key": "caller:retry-1",
        "from_agent": "agent-demo",
        "from_line": "frontend",
        "from_session": "session-11111111-1111-1111-1111-111111111111",
        "to_agent": "agent-demo",
        "to_line": "backend",
        "body": "build 产物已就绪，请拉到 backend 线验收。",
        "created_at": 1793757000000,
        "expires_at": null,
        "reply_to": null,
        "root_message_id": null,
        "hop": 0,
        "no_reply": 0,
        "kind": "request",
        "cc_manager": 0,
        "approval_state": null,
        "task_ref": null,
        "parent_task_ref": null,
        "task_scope": null,
        "subteam_policy": null,
        "max_members": null,
        "approved_by": null,
        "approved_at": null,
        "state": "queued",
        "claimed_by": null,
        "claimed_at": null,
        "delivered_at": null,
        "acked_at": null,
        "attempts": 0,
        "next_attempt_at": 0,
        "last_error": null
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.3"
      }
    }
  ]
}
