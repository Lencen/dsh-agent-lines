        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info"
      },
      "expect": {
        "ok": false,
        "errorCode": "LINE_PROTOCOL_MISMATCH"
      }
    },
    {
      "name": "d/stored-message-major-1.0",
      "note": "存储侧 protocol_version 列 major 不兼容",
