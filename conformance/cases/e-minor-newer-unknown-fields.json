{
  "suite": "e-minor-newer",
  "description": "minor 更高且含未知字段 -> 接受，忽略未知字段（对应 conformance/README.md 第 5 类）。",
  "cases": [
    {
      "name": "e/minor-0.5-unknown-top-level-and-nested",
      "note": "0.5 新增字段必须被忽略，schema 与版本协商都通过",
      "check": "schema",
      "schema": "envelope.v0_4",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.5",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111",
          "machine": "host-a"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info",
        "traceId": "trace-from-0.5",
        "annotations": [
          "future",
          "fields"
        ]
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.5"
      }
    },
    {
      "name": "e/minor-0.12-compatible",
      "note": "minor 两位数同样兼容",
      "check": "protocolVersion",
      "input": {
        "id": "msg_0123456789abcdef0123456789abcdef",
        "protocolVersion": "0.12",
        "idempotencyKey": "caller:retry-1",
        "from": {
          "agentId": "agent-demo",
          "line": "frontend",
          "sessionId": "session-11111111-1111-1111-1111-111111111111"
        },
        "to": {
          "agentId": "agent-demo",
          "line": "backend"
        },
        "body": {
          "text": "build 产物已就绪，请拉到 backend 线验收。"
        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info",
        "futureFlag": true
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.12"
      }
    },
    {
      "name": "e/stored-message-minor-0.5",
      "note": "存储侧 protocol_version 0.5 + 未知列",
      "check": "schema",
      "schema": "message.v0_4",
