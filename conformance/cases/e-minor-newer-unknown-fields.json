        },
        "createdAt": 1793757000000,
        "expiresAt": null,
        "replyTo": null,
        "rootMessageId": null,
        "hop": 0,
        "noReply": false,
        "kind": "info",
        "futureFlag": true
      },
      "expect": {
        "ok": true,
        "protocolVersion": "0.12"
      }
