{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lencen/dsh-agent-lines/schema/envelope.v0_4.json",
  "title": "dsh-agent-lines envelope (protocol 0.4)",
  "description": "线间消息信封（wire format），对应 docs/PROTOCOL.md『信封』与『版本协商』。additionalProperties: true 是有意为之：minor 升级新增的未知字段必须被忽略而不是拒绝。protocolVersion 不在 required 中：0.9.0 之前的信封没有该字段，接收方按 0.3 处理（兼容）。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "idempotencyKey",
    "from",
    "to",
    "body",
    "createdAt",
    "hop",
    "noReply"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "消息 id；newMessageId() 生成 msg_<uuid>"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "default": "0.3",
      "description": "major.minor；缺省视为 0.3（旧信封）。major 不同 = 不兼容 -> LINE_PROTOCOL_MISMATCH；minor 更高 = 兼容。"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^(caller|auto):.+$",
      "description": "caller:<key> 由调用方控制；auto:<sha256> 每次发送生成"
    },
    "from": {
      "$ref": "#/$defs/from"
    },
    "to": {
      "$ref": "#/$defs/to"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "description": "epoch 毫秒"
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "epoch 毫秒；null = 不过期"
    },
    "replyTo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "被回复消息 id；根消息为 null"
    },
    "rootMessageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "回复链根消息 id；根消息为 null"
    },
    "hop": {
      "type": "integer",
      "minimum": 0,
      "description": "回复深度；根消息为 0，回复为 parent.hop + 1"
    },
    "noReply": {
      "type": "boolean",
      "description": "true = 通知类消息，禁止自动回复（LINE_NO_REPLY）"
    },
    "kind": {
      "type": "string",
      "enum": [
        "info",
        "request",
        "task",
        "alert"
      ]
    },
    "ccManager": {
      "type": "boolean",
      "description": "可选：同时抄送上级线"
    }
  },
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
      "description": "Agent id；与 lib/protocol.js 的 AGENT_RE 一致"
    },
    "line": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Line 标签；与 lib/protocol.js 的 LINE_RE 一致"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "消息 id；newMessageId() 生成 msg_<uuid>"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "DSH Session id，通常形如 session-<uuid>"
    },
    "from": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentId",
        "line",
        "sessionId"
      ],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentId",
        "line"
      ],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "正文；空/超 maxMessageBytes 由 lib 拒绝（LINE_EMPTY_MESSAGE / LINE_MESSAGE_TOO_LARGE）"
        }
      }
    }
  }
}
