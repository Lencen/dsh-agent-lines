{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lencen/dsh-agent-lines/schema/message.v0_4.json",
  "title": "dsh-agent-lines stored message row (messages table, snake_case)",
  "description": "存储侧 messages 表行的 schema。additionalProperties: true（实现新增列不会破坏校验；注意 claimed_by/approved_by 自首版建表即存在，不是 0.9.x 新增）。protocol_version 列 NOT NULL DEFAULT '0.3'，旧行迁移时填充。wire 信封见 envelope.v0_4.json；DB 行到信封的转换见 lib/protocol.js 的 toEnvelope(row)。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "idempotency_key",
    "from_agent",
    "from_line",
    "from_session",
    "to_agent",
    "to_line",
    "body",
    "created_at",
    "state",
    "attempts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msg_[a-f0-9]{32}$"
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "from_agent": {
      "$ref": "#/$defs/agentId"
    },
    "from_line": {
      "$ref": "#/$defs/line"
    },
    "from_session": {
      "type": "string",
      "minLength": 1
    },
    "to_agent": {
      "$ref": "#/$defs/agentId"
    },
    "to_line": {
      "$ref": "#/$defs/line"
    },
    "body": {
      "type": "string"
    },
    "created_at": {
      "type": "integer",
      "minimum": 0
    },
    "expires_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "reply_to": {
      "type": [
        "string",
        "null"
      ]
    },
    "root_message_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "hop": {
      "type": "integer",
      "minimum": 0
    },
    "no_reply": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "kind": {
      "type": "string",
      "enum": [
        "info",
        "request",
        "task",
        "alert"
      ]
    },
    "cc_manager": {
      "type": "integer",
      "enum": [
        0,
        1
      ]
    },
    "approval_state": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_task_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "task_scope": {
      "type": [
        "string",
        "null"
      ]
    },
    "subteam_policy": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "auto",
        "ask",
        "never",
        null
      ]
    },
    "max_members": {
      "type": [
        "integer",
        "null"
      ]
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "default": "0.3",
      "description": "存储列名 snake_case；缺省/旧行 = 0.3"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "delivered",
        "acked",
        "failed",
        "expired",
        "pending_approval"
      ]
    },
    "claimed_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "claimed_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "delivered_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "acked_at": {
      "type": [
        "integer",
        "null"
      ]
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "next_attempt_at": {
      "type": "integer"
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$"
    },
    "line": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    }
  }
}
