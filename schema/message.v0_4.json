{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Lencen/dsh-agent-lines/schema/message.v0_4.json",
  "title": "dsh-agent-lines stored message (protocol 0.4)",
  "description": "存储侧消息 = 信封字段 + messages 表列（state/attempts/deliveredAt/ackedAt/lastError/protocol_version）。本文件自包含：所有 $ref 均指向本文件 #/$defs，可直接交给任意 JSON Schema 校验器。additionalProperties: true 允许 0.9.x 新增列（如 claimed_by）而不破坏校验。protocol_version 列在 SQLite 中为 NOT NULL DEFAULT '0.3'，旧行迁移时填充；此处保持可选并给 default，保证『旧消息无版本』在存储侧同样被接受为 0.3。",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "idempotencyKey",
    "from",
    "to",
    "body",
    "createdAt",
    "hop",
    "noReply",
    "kind",
    "state",
    "attempts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "消息 id；newMessageId() 生成 msg_<uuid>"
    },
    "protocolVersion": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "default": "0.3",
      "description": "major.minor；缺省视为 0.3（旧信封）。major 不同 = 不兼容 -> LINE_PROTOCOL_MISMATCH；minor 更高 = 兼容。"
    },
    "idempotencyKey": {
      "type": "string",
      "pattern": "^(caller|auto):.+$",
      "description": "caller:<key> 由调用方控制；auto:<sha256> 每次发送生成"
    },
    "from": {
      "$ref": "#/$defs/from"
    },
    "to": {
      "$ref": "#/$defs/to"
    },
    "body": {
      "$ref": "#/$defs/body"
    },
    "createdAt": {
      "type": "integer",
      "minimum": 0,
      "description": "epoch 毫秒"
    },
    "expiresAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "epoch 毫秒；null = 不过期"
    },
    "replyTo": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "被回复消息 id；根消息为 null"
    },
    "rootMessageId": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "回复链根消息 id；根消息为 null"
    },
    "hop": {
      "type": "integer",
      "minimum": 0,
      "description": "回复深度；根消息为 0，回复为 parent.hop + 1"
    },
    "noReply": {
      "type": "boolean",
      "description": "true = 通知类消息，禁止自动回复（LINE_NO_REPLY）"
    },
    "kind": {
      "type": "string",
      "enum": [
        "info",
        "request",
        "task",
        "alert"
      ]
    },
    "ccParent": {
      "type": "boolean",
      "description": "可选：同时抄送上级线"
    },
    "state": {
      "type": "string",
      "enum": [
        "queued",
        "claimed",
        "delivered",
        "acked",
        "failed",
        "expired",
        "pending_approval"
      ],
      "description": "状态机见 docs/PROTOCOL.md『状态机』；pending_approval = 非管理线发送的 task 待 line_manager_ack"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0,
      "description": "已尝试投递次数；>= maxAttempts 后落 failed"
    },
    "deliveredAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "delivered 时间（epoch 毫秒）"
    },
    "ackedAt": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "description": "acked 时间（epoch 毫秒）"
    },
    "lastError": {
      "type": [
        "string",
        "null"
      ],
      "description": "最近一次错误；协议不兼容时形如 LINE_PROTOCOL_MISMATCH: peer 1.0"
    },
    "protocol_version": {
      "type": "string",
      "pattern": "^\\d{1,3}\\.\\d{1,3}$",
      "default": "0.3",
      "description": "存储列名用 snake_case；缺省/旧行 = 0.3"
    }
  },
  "$defs": {
    "agentId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,95}$",
      "description": "Agent id；与 lib/protocol.js 的 AGENT_RE 一致"
    },
    "line": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Line 标签；与 lib/protocol.js 的 LINE_RE 一致"
    },
    "messageId": {
      "type": "string",
      "pattern": "^msg_[A-Za-z0-9_-]{1,128}$",
      "description": "消息 id；newMessageId() 生成 msg_<uuid>"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "description": "DSH Session id，通常形如 session-<uuid>"
    },
    "from": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentId",
        "line",
        "sessionId"
      ],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "line": {
          "$ref": "#/$defs/line"
        },
        "sessionId": {
          "$ref": "#/$defs/sessionId"
        }
      }
    },
    "to": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "agentId",
        "line"
      ],
      "properties": {
        "agentId": {
          "$ref": "#/$defs/agentId"
        },
        "line": {
          "$ref": "#/$defs/line"
        }
      }
    },
    "body": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "正文；空/超 maxMessageBytes 由 lib 拒绝（LINE_EMPTY_MESSAGE / LINE_MESSAGE_TOO_LARGE）"
        }
      }
    }
  }
}
